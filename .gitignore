# Geheimnisse -- niemals ins Repo
secrets.yaml
secrets.local.yaml
*.secret
.env

# ESPHome-Build-Artefakte (falls das Projekt in diese Richtung geht)
/.esphome/
/.esphome-venv/

# Python
__pycache__/
*.py[cod]
.venv/

# Lokale Entwuerfe/Zwischenstufen -- bleiben lokal, halten das Repo sauber
/Entwuerfe/
/Entwurf/

# Stray Clipboard-Screenshots (zeigen oft MAC-/Router-Infos)
Clipboard*.png

# OS-Kram
Thumbs.db
desktop.ini
.DS_Store

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Arduino IDE Build-Cache
/Firmware/bristlebot/build/

# Editor
.vscode/
*.code-workspace

# Lokale UI-Vorschau mit Daten-Stub, kein Teil der Firmware
.preview/

# Datenblaetter Dritter -- lokal nuetzlich, aber nicht unsere zum Weitergeben
Datasheets/

# KiCad-Zwischenergebnisse
pcb/_render/
pcb/_symcheck/
pcb/_erc.rpt
pcb/_netlist.xml
pcb/*-backups/
pcb/fp-info-cache

# KiCad-Sperrdateien -- entstehen beim Oeffnen, gehoeren niemandem sonst
*.lck

# Lokale Dateihistorie der Editor-Erweiterung
.history/

# Screenshots zum Durchsehen -- wie pcb/_render/ reine Zwischenergebnisse
pcb/Bilder/

# 3D-Modelle Dritter -- lokal gebraucht, nicht unsere zum Weitergeben
local_Step Files/

# KiCad-Platinen-Zwischenergebnisse
pcb/_drc.json
pcb/_nl*.xml

# Fertigungsdaten: die Archive und die Listen kommen ins Repo, die
# ausgepackten Einzeldateien nicht -- sie stehen schon im Archiv und
# wuerden bei jedem Neuerzeugen rauschen.
Fertigung/gerber/
Fertigung/pastenschablone/
